<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel - Abandoned Shop</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body background="/images/background.gif">
    <table width="50%" border="1" bgcolor="rgba(192, 192, 192, 0.5)" align="center">
        <tr>
            <td align="center">
                <h1 style="font-family: Times New Roman; color: #FF0000;">Admin Panel</h1>
                <p style="font-family: Courier New; color: #AAAAAA;">Welcome back, administrator.</p>
                <div style="border: 2px solid #00FF00; padding: 20px; margin: 20px; background: rgba(0,30,0,0.7);">
                    <p style="font-family: Courier New; color: #00FF00; font-size: 18px;">&#x1F6A9; FLAG</p>
                    <p style="font-family: Courier New; color: #00FF00; font-size: 16px; word-break: break-all;"><%= flag %></p>
                </div>
            </td>
        </tr>
    </table>
    <img src="/images/i-see-you-eyes.gif" class="static-overlay" alt="static">
</body>
</html>
