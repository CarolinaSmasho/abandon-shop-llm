<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel - Abandoned Shop</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body background="/images/background.gif">
    <table width="50%" border="1" bgcolor="rgba(192, 192, 192, 0.5)" align="center">
        <tr>
            <td align="center">
                <h1 style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; text-shadow: 0 0 14px #00CCFF, 0 0 30px rgba(0,204,255,0.4);">Admin Panel</h1>
                <p style="font-family: Courier New; color: #AAAAAA;">Welcome back, administrator.</p>
                <div style="border: 2px solid #00CCFF; padding: 20px; margin: 20px; background: rgba(0,20,40,0.85); box-shadow: 0 0 16px rgba(0,204,255,0.5);">
                    <p style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; font-size: 18px; text-shadow: 0 0 8px #00CCFF;">&#x1F6A9; FLAG</p>
                    <p style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00FFFF; font-size: 16px; word-break: break-all; text-shadow: 0 0 6px #00FFFF;"><%= flag %></p>
                </div>
            </td>
        </tr>
    </table>
    <img src="/images/i-see-you-eyes.gif" class="static-overlay" alt="static">
</body>
</html>
