<!DOCTYPE html>
<html>
<head>
    <title>Abandoned Shop</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js"></script>
</head>
<body background="/images/background.gif">
    <table width="100%" border="1" bgcolor="rgba(192, 192, 192, 0.5)">
        <tr>
            <td align="center">
                <h1 style="font-family: Times New Roman; color: #FF0000;">Welcome to the Abandoned Shop</h1>
                <marquee>Some doors are left unlocked by mistake...</marquee>
            </td>
        </tr>
        <tr>
            <td align="center">
                <form method="GET" action="/">
                    <input type="text" name="search" placeholder="Search products" value="<%= searchQuery %>" style="font-family: Courier New;">
                    <input type="submit" value="Search">
                </form>
            </td>
        </tr>
        <tr>
            <td>
                <% if (products.length > 0) { %>
                    <table width="100%" border="0" class="product-table">
                        <% let count = 0; %>
                        <% products.forEach(product => { %>
                            <% if (count % 3 === 0) { %>
                                <% if (count > 0) { %>
                                    </tr>
                                <% } %>
                                <tr>
                            <% } %>
                            <td class="product-card">
                                <img src="<%= product.image_url %>" alt="<%= product.name %>" width="100" height="100">
                                <p style="font-family: Courier New;"><%= product.name %></p>
                                <p style="font-family: Courier New;">$<%= product.price %></p>
                            </td>
                            <% count++; %>
                        <% }); %>
                        <% if (count % 3 !== 0) { %>
                            </tr>
                        <% } %>
                    </table>
                <% } else { %>
                    <p class="no-results">No products found...</p>
                <% } %>
                <p style="color: #800080; font-family: Arial;">This shop is always open... but nobody’s here.</p>
            </td>
        </tr>
    </table>
    <img src="/images/static.gif" class="static-overlay" alt="static">
</body>
</html>