<!DOCTYPE html>
<html>
<head>
    <title><%= product.name %> - Abandoned Shop</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/chat.js" defer></script>
</head>
<body background="/images/background.gif">

    <div style="width: 65%; margin: 0 auto; padding: 10px 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <a href="/" style="font-family: Courier New; font-size: 13px; color: #AAAAAA; text-decoration: none; border: 1px solid #555; padding: 4px 10px; background: rgba(0,0,0,0.5);">&#x2190; Back to Shop</a>
            <a href="/login" style="font-family: Courier New; font-size: 13px; color: #AAAAAA; text-decoration: none; border: 1px solid #555; padding: 4px 10px; background: rgba(0,0,0,0.5);">Login</a>
        </div>
    </div>

    <!-- Product Info -->
    <table width="65%" border="1" bgcolor="rgba(192, 192, 192, 0.5)" align="center" style="margin-bottom: 12px;">
        <tr>
            <td style="padding: 20px;">
                <table width="100%" border="0">
                    <tr>
                        <td width="180" style="vertical-align: top; text-align: center;">
                            <img src="<%= product.image_url %>" alt="<%= product.name %>" width="160" height="160" style="border: 2px solid #333; image-rendering: pixelated;">
                        </td>
                        <td style="vertical-align: top; padding-left: 20px;">
                            <h2 style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; text-shadow: 0 0 10px #00CCFF; margin: 0 0 10px 0;"><%= product.name %></h2>
                            <p style="font-family: 'Share Tech Mono','Courier New',monospace; font-size: 20px; color: #00FFFF; text-shadow: 0 0 6px #00FFFF; margin: 0 0 12px 0;">$<%= product.price %></p>
                            <% if (product.description) { %>
                                <p style="font-family: Courier New; font-size: 13px; color: #CCCCCC; line-height: 1.6;"><%= product.description %></p>
                            <% } %>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Reviews -->
    <table width="65%" border="1" bgcolor="rgba(192, 192, 192, 0.5)" align="center" style="margin-bottom: 12px;">
        <tr>
            <td style="padding: 16px;">
                <h3 style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; text-shadow: 0 0 8px #00CCFF; margin: 0 0 12px 0;">&#x2605; Customer Reviews</h3>
                <% if (reviews.length > 0) { %>
                    <% reviews.forEach(r => { %>
                        <div style="border-bottom: 1px solid #444; padding: 10px 0;">
                            <span style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; font-size: 12px; font-weight: bold;"><%= r.reviewer %></span>
                            <span style="font-family: Courier New; color: #666; font-size: 11px; margin-left: 8px;"><%= r.created_at %></span>
                            <p style="font-family: Courier New; color: #CCCCCC; font-size: 13px; margin: 6px 0 0 0; line-height: 1.5;"><%= r.body %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="font-family: Courier New; color: #666; font-size: 13px;">No reviews yet. Be the first to review this item.</p>
                <% } %>
            </td>
        </tr>
    </table>

    <!-- Review Form -->
    <table width="65%" border="1" bgcolor="rgba(192, 192, 192, 0.5)" align="center" style="margin-bottom: 20px;">
        <tr>
            <td style="padding: 16px;">
                <h3 style="font-family: 'Share Tech Mono','Courier New',monospace; color: #00CCFF; text-shadow: 0 0 8px #00CCFF; margin: 0 0 12px 0;">&#x270F; Write a Review</h3>
                <form method="POST" action="/reviews">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <p style="margin: 6px 0;">
                        <label style="font-family: Courier New; font-size: 12px; color: #CCC; display: block; margin-bottom: 4px;">Your Name</label>
                        <input type="text" name="reviewer" placeholder="Anonymous" maxlength="50" style="font-family: Courier New; background:#222; color:#FFF; border:1px solid #555; padding:5px 8px; width:100%; box-sizing:border-box;">
                    </p>
                    <p style="margin: 6px 0;">
                        <label style="font-family: Courier New; font-size: 12px; color: #CCC; display: block; margin-bottom: 4px;">Review</label>
                        <textarea name="body" placeholder="Share your experience..." maxlength="1000" rows="4" style="font-family: Courier New; background:#222; color:#FFF; border:1px solid #555; padding:5px 8px; width:100%; box-sizing:border-box; resize:vertical;"></textarea>
                    </p>
                    <input type="submit" value="Submit Review">
                </form>
            </td>
        </tr>
    </table>

    <!-- AI Support Chat Widget -->
    <div id="chat-widget" data-product="<%= product.name %>">
        <button id="chat-toggle">&#x1F4AC; AI Support</button>
        <div id="chat-panel">
            <div id="chat-header">
                <span>&#x26A0; Shop Assistant (Beta)</span>
                <div style="display:flex;gap:6px;">
                    <button id="chat-reset" title="Clear chat history">&#x21BA;</button>
                    <button id="chat-close">&#x2715;</button>
                </div>
            </div>
            <div id="chat-messages"></div>
            <div id="chat-input-row">
                <input type="text" id="chat-input" placeholder="Type a message..." autocomplete="off">
                <button id="chat-send">Send</button>
            </div>
        </div>
    </div>

</body>
</html>
