<!DOCTYPE html>
<html>
<head>
    <title>Red Room - Abandoned Shop</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="/script.js"></script>
</head>
<body background="/images/art.jpg">
    <div id="canvas-container" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
    <script>
        // Three.js code for 3D cube with 2D text on one face
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('canvas-container').appendChild(renderer.domElement);

        // Create cube
        const geometry = new THREE.BoxGeometry(2, 2, 2);

        // Create canvas for 2D text
        const canvas = document.createElement('canvas');
        canvas.width = 256;
        canvas.height = 256;
        const context = canvas.getContext('2d');
        context.fillStyle = '#000000'; // Black background for text
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.font = '40px Courier New';
        context.fillStyle = '#FF0000'; // Red neon text
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        context.fillText("MD5", canvas.width / 2, canvas.height / 2);

        const canvas2 = document.createElement('canvas');
        canvas2.width = 256;
        canvas2.height = 256;
        const context2 = canvas2.getContext('2d');
        context2.fillStyle = '#000000'; // Black background for text
        context2.fillRect(0, 0, canvas2.width, canvas2.height);
        context2.font = '40px Courier New';
        context2.fillStyle = '#FF0000'; // Red neon text
        context2.textAlign = 'center';
        context2.textBaseline = 'middle';
        context2.fillText("B64", canvas2.width / 2, canvas2.height / 2);

        const canvas3 = document.createElement('canvas');
        canvas3.width = 256;
        canvas3.height = 256;
        const context3 = canvas3.getContext('2d');
        context3.fillStyle = '#000000'; // Black background for text
        context3.fillRect(0, 0, canvas3.width, canvas3.height);
        context3.font = '40px Courier New';
        context3.fillStyle = '#FF0000'; // Red neon text
        context3.textAlign = 'center';
        context3.textBaseline = 'middle';
        context3.fillText("/secrets", canvas3.width / 2, canvas3.height / 2);


        // Create texture from canvas
        const textTexture = new THREE.CanvasTexture(canvas);
        const topTexture = new THREE.CanvasTexture(canvas2);
        const sideTexture = new THREE.CanvasTexture(canvas3);
        

        // Materials for cube faces
        const materials = [
            new THREE.MeshBasicMaterial({ color: 0xFF0000, side: THREE.BackSide }), // Right
            new THREE.MeshBasicMaterial({ map: sideTexture, side: THREE.BackSide }), // Left
            new THREE.MeshBasicMaterial({ map: topTexture, side: THREE.BackSide }), // Top
            new THREE.MeshBasicMaterial({ color: 0xFF0000, side: THREE.BackSide }), // Bottom
            new THREE.MeshBasicMaterial({ color: 0xFF0000, side: THREE.BackSide }), // Front (transparent)
            new THREE.MeshBasicMaterial({ map: textTexture, side: THREE.BackSide }) // Back (with text)
        ];
        const cube = new THREE.Mesh(geometry, materials);
        scene.add(cube);

        camera.position.z = 5;

        // Animation loop
        let glitchTime = 0;
        function animate() {
            requestAnimationFrame(animate);
            // cube.rotation.x += 0.01;
            cube.rotation.y += 0.01;

            // Glitch effect: update texture opacity randomly
            glitchTime += 0.1;
            if (Math.random() < 0.1) { // 10% chance to glitch
                context.fillStyle = '#000000';
                context.fillRect(0, 0, canvas.width, canvas.height);
                context.fillStyle = `#FF${Math.floor(Math.random() * 256).toString(16).padStart(2, '0')}00`; // Random red shade
                context.fillText("MD5", canvas.width / 2, canvas.height / 2);
                textTexture.needsUpdate = true;

                context2.fillStyle = '#000000';
                context2.fillRect(0, 0, canvas.width, canvas.height);
                context2.fillStyle = `#FF${Math.floor(Math.random() * 256).toString(16).padStart(2, '0')}00`; // Random red shade
                context2.fillText("B64", canvas.width / 2, canvas.height / 2);
                topTexture.needsUpdate = true;

                context3.fillStyle = '#000000';
                context3.fillRect(0, 0, canvas.width, canvas.height);
                context3.fillStyle = `#FF${Math.floor(Math.random() * 256).toString(16).padStart(2, '0')}00`; // Random red shade
                context3.fillText("/secrets", canvas.width / 2, canvas.height / 2);
                sideTexture.needsUpdate = true;
            }

            renderer.render(scene, camera);
        }
        animate();

        // Handle window resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>